---
layout: base.njk
title: Yurt Dışında Ara
ozet: Ürünü yazın, seçtiğiniz ülkedeki satıcıları, fiyatları ve Türkiye'ye göre farkı görün.
permalink: /ara/
---
<h1>Yurt Dışında Ara</h1>
<p class="slogan">Ürünü yazın: önce markanın resmi fiyatı, sonra yetkili satıcılar, elektronik mağazaları ve pazar yerleri. Hepsi güncel kurla TL olarak.</p>

<form class="hesap" id="arama">
  <label>Ülke
    <select id="ulke">
      {%- for u in ulkeler %}
      <option value="{{ u.kod }}">{{ u.ad }}</option>
      {%- endfor %}
    </select>
  </label>
  <label>Ürün türü
    <select id="tur">
      {%- for t in turler %}
      <option value="{{ t.kod }}">{{ t.ad }}</option>
      {%- endfor %}
    </select>
  </label>
  <label id="numaraAlan" hidden>Numaranız (EU, isteğe bağlı)
    <select id="numara">
      <option value="">Seçin</option>
      {%- for t in turler %}{% for n in t.numaralar %}
      <option value="{{ n.eu }}">EU {{ n.eu }}</option>
      {%- endfor %}{% endfor %}
    </select>
  </label>
  <label>Ürün adı veya model kodu
    <input id="q" type="search" required minlength="2" placeholder="Örn. H70405140, GMW-BZ5000GD-9 veya Air Force 1 CW2288-111">
  </label>
  <label>Türkiye fiyatı (TL, isteğe bağlı)
    <input id="trFiyat" type="number" inputmode="decimal" min="0" step="any" placeholder="Karşılaştırma için">
  </label>
  <label>Sıralama
    <select id="sira">
      <option value="ilgi">En ilgili</option>
      <option value="ucuz">En ucuz</option>
      <option value="puan">En yüksek puan</option>
    </select>
  </label>
  <button type="submit">Ara</button>
</form>

<p class="meta" id="durum"></p>
<div id="numaraBilgi"></div>
<div id="bizden"></div>
<div id="ozet"></div>
<div id="kademeler"></div>
<p class="meta">Resmi fiyat markanın Japonya sitesinden veya markanın resmi Rakuten mağazasından alınır. Diğer fiyatlar Rakuten'deki satıcılardan gelir. Online alışverişte vergi iadesi yoktur ve ürün Japonya'daki bir adrese (örneğin otel) gönderilmelidir. "Resmi garantili" bilgisi satıcının beyanıdır. Model kodunu mutlaka kontrol edin.</p>

<script src="/js/hesap.js"></script>
<script src="/js/japonca.js"></script>
<script>
const ULKELER = {{ ulkeler | dump | safe }};
const TURLER = {{ turler | dump | safe }};
const SAATLER = [
  {%- for p in collections.saatler %}
  { ad: {{ p.data.title | dump | safe }}, referans: {{ p.data.referans | dump | safe }}, url: "{{ p.url }}", ulke: "{{ p.data.ulke }}", tr: {{ p.data.tr_fiyat or "null" }} },
  {%- endfor %}
];
// Resmi fiyat otomatik bulunamazsa gösterilecek marka siteleri (ilan başlıklarından tanınır).
const MARKA_SITELERI = [
  [/CASIO|カシオ|G-SHOCK|Gショック/i, "Casio", "https://www.casio.com/jp/watches/"],
  [/SEIKO|セイコー/i, "Seiko", "https://www.seikowatches.com/jp-ja"],
  [/CITIZEN|シチズン/i, "Citizen", "https://citizen.jp/"],
  [/ORIENT|オリエント/i, "Orient", "https://www.orient-watch.jp/"],
  [/HAMILTON|ハミルトン/i, "Hamilton", "https://www.hamiltonwatch.com/ja-jp/"],
  [/TISSOT|ティソ/i, "Tissot", "https://www.tissotwatches.com/ja-jp/"],
  [/LONGINES|ロンジン/i, "Longines", "https://www.longines.com/ja-jp/"],
  [/NIKE|ナイキ/i, "Nike", "https://www.nike.com/jp/"],
  [/ADIDAS|アディダス/i, "Adidas", "https://www.adidas.co.jp/"],
  [/NEW BALANCE|ニューバランス/i, "New Balance", "https://shop.newbalance.jp/"],
  [/ASICS|アシックス/i, "Asics", "https://www.asics.com/jp/ja-jp/"],
  [/ONITSUKA|オニツカ/i, "Onitsuka Tiger", "https://www.onitsukatiger.com/jp/ja-jp/"],
];
const KADEMELER = [
  { tur: "yetkili", baslik: "Yetkili satıcılar", aciklama: "Resmi garantili sattığını belirten mağazalar. Bazı markalarda (ör. Seiko, Casio) resmi fiyatın altında satarlar; her ilanda resmi fiyata göre fark yazıyor." },
  { tur: "zincir", baslik: "Elektronik ve indirim mağazaları", aciklama: "Bu zincirlerin fiziksel şubelerinde pasaportla vergi iadesi de alınabilir. Saati mağazada sormak için aşağıdaki Japonca adı gösterin." },
  { tur: "pazar", baslik: "Pazar yeri satıcıları", aciklama: "Rakuten'deki diğer satıcılar. Fiyatlar resmi fiyattan yüksek veya düşük olabilir; satıcı puanına bakın." },
  { tur: "ikinciel", baslik: "İkinci el", aciklama: "Kullanılmış ürünler." },
];
const { kurGetir, hesapla, tl, para, euro, fark, GUMRUK_METNI, kararHtml } = Zamanist;
const { temizle, etiketler, santimler } = Japonca;

// "27 cm, 27.5 cm" -> "27 cm (EU 42.5), 27.5 cm (EU 43)"
function cmToEu(etiket, numaralar) {
  return etiket.split(", ").map((p) => {
    const n = numaralar.find((x) => parseFloat(x.cm) === parseFloat(p));
    return n ? `${p} (EU ${n.eu})` : p;
  }).join(", ");
}

function numaraGoster() {
  const t = TURLER.find((x) => x.kod === $("tur").value);
  $("numaraAlan").hidden = !t.numaralar;
  const n = t.numaralar && t.numaralar.find((x) => x.eu === $("numara").value);
  $("numaraBilgi").innerHTML = n
    ? `<div class="sonuc"><strong>Numaranız:</strong> EU ${n.eu} = Japonya'da <strong>${n.cm} cm</strong> = US ${n.us} = UK ${n.uk}<p class="meta">${kacis(t.numaraNotu)}</p></div>`
    : "";
}
const $ = (id) => document.getElementById(id);
const kacis = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const sade = (s) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
let sonVeri = null;

// Model koduyla arandığında, ilan linkindeki ürün kodu farklı bir modeli gösteriyorsa uyar.
// Sorgudaki model kodu: harf ve rakam içeren en uzun kelime ("TISSOT T129... CLASSIC" -> "t129...").
const modelKodu = (q) => q.split(/[\s,/]+/).map(sade).filter((k) => /[a-z]/.test(k) && /[0-9]/.test(k) && k.length >= 5).sort((a, b) => b.length - a.length)[0] || sade(q);

function kodFarkli(r, q) {
  const kod = modelKodu(q);
  if (!/[a-z]/.test(kod) || !/[0-9]/.test(kod)) return false;
  const linkKodu = sade(new URL(r.link).pathname.split("/").filter(Boolean).pop() || "");
  return /[a-z]/.test(linkKodu) && /[0-9]/.test(linkKodu) && !linkKodu.includes(kod) && !kod.includes(linkKodu);
}

function resmiFarki(fiyat, resmi) {
  if (!resmi) return "";
  const y = Math.round((fiyat / resmi.fiyat - 1) * 100);
  if (Math.abs(y) < 3) return '<span class="etiket">Resmi fiyatla aynı</span>';
  return y > 0 ? `<span class="etiket uyari">Resmi fiyatın %${y} üstünde</span>` : `<span class="etiket iyi">Resmi fiyatın %${-y} altında</span>`;
}

function satir({ r, s }, ctx) {
  const tr = etiketler(r.ad, ctx.urunTuru).map((e) => ctx.numaralar && / cm/.test(e) ? cmToEu(e, ctx.numaralar) : e);
  const numaraVar = ctx.secili && santimler(r.ad).includes(String(parseFloat(ctx.secili.cm)));
  return `
    <li>
      ${r.resim ? `<img src="${kacis(r.resim)}" alt="" loading="lazy">` : "<span></span>"}
      <div>
        <div class="fiyat">${para(r.fiyat, ctx.u.para)} = ${tl(s.netTl)} ${resmiFarki(r.fiyat, ctx.resmi)}</div>
        ${tr.length ? `<div class="tr-etiketler">${tr.map(kacis).join(" · ")}</div>` : ""}
        <a class="jp-ad" href="${kacis(r.link)}" target="_blank" rel="nofollow noopener" lang="ja">${kacis(temizle(r.ad).slice(0, 110))}</a>
        <div class="meta">${kacis(r.magaza)}${r.puan ? ` · ★ ${r.puan.toFixed(2)} (${r.yorumSayisi} yorum)` : " · Puan yok"}${r.kargoDahil ? " · Kargo dahil" : ""}</div>
        <div>${r.aksesuar ? '<span class="etiket uyari">Aksesuar olabilir</span> ' : ""}${kodFarkli(r, ctx.q) ? '<span class="etiket uyari">Model kodu farklı olabilir</span>' : ""}${numaraVar ? '<span class="etiket iyi">Numaranız ilanda geçiyor</span>' : ""}</div>
        ${s.karar ? `<div class="meta">Türkiye'ye göre: ${fark(s.gumrukTl > 0 ? s.farkVergili : s.farkVergisiz, ctx.trFiyat)}${s.gumrukTl > 0 ? " (gümrük vergisi dahil)" : ""}</div>` : ""}
      </div>
    </li>`;
}

function ciz() {
  if (!sonVeri) return;
  const { u, kur, q, sonuclar, resmiSite, urunTuru } = sonVeri;
  const trFiyat = parseFloat($("trFiyat").value);
  const sira = $("sira").value;

  // Resmi fiyat: önce markanın sitesi, yoksa markanın resmi Rakuten mağazası.
  const resmiRakuten = sonuclar.filter((r) => r.tur === "resmi" && !r.aksesuar && !kodFarkli(r, q)).sort((a, b) => a.fiyat - b.fiyat)[0];
  const resmi = resmiSite?.bulundu
    ? { fiyat: resmiSite.fiyat, kaynak: `${resmiSite.marka} ${u.ad} resmi sitesi`, link: resmiSite.link, jpAd: resmiSite.urunAdi }
    : resmiRakuten ? { fiyat: resmiRakuten.fiyat, kaynak: `${resmiRakuten.magaza} (markanın resmi Rakuten mağazası)`, link: resmiRakuten.link, jpAd: temizle(resmiRakuten.ad) }
    : null;
  const turBilgi = TURLER.find((x) => x.kod === urunTuru);
  const secili = turBilgi.numaralar && turBilgi.numaralar.find((x) => x.eu === $("numara").value);
  const ctx = { u, q, resmi, trFiyat, urunTuru, numaralar: turBilgi.numaralar, secili };

  // Mağazada gösterilecek Japonca ad
  const jpAd = resmi?.jpAd || (sonuclar.find((r) => r.tur !== "ikinciel" && !r.aksesuar && !kodFarkli(r, q)) || {}).ad;
  let ozet = `<div class="sonuc"><h2>1. Markanın resmi fiyatı</h2>`;
  if (resmi) {
    const s = hesapla({ fiyat: resmi.fiyat, ulke: u, kur, trFiyat, iadeli: true });
    ozet += `<dl>
      <dt>Resmi fiyat</dt><dd><strong>${para(resmi.fiyat, u.para)} = ${tl(resmi.fiyat * kur.TRY)}</strong> · <a href="${kacis(resmi.link)}" target="_blank" rel="nofollow noopener">${kacis(resmi.kaynak)}</a></dd>
      <dt>Mağazadan pasaportla</dt><dd>${tl(s.netTl)} (vergi iadesi sonrası, yaklaşık ${euro(s.netEur)})</dd>
      <dt>Gümrük</dt><dd>${GUMRUK_METNI[s.gumruk](s)}</dd>
      ${s.karar ? `<dt>Türkiye'ye göre</dt><dd>${s.gumrukTl > 0 ? `Gümrük vergisi hariç ${fark(s.farkVergisiz, trFiyat)}<br>Gümrük vergisi dahil ${fark(s.farkVergili, trFiyat)}` : fark(s.farkVergisiz, trFiyat)}</dd>` : ""}
    </dl>${kararHtml(s.karar)}`;
  } else {
    const basliklar = sonuclar.map((r) => r.ad).join(" ");
    const marka = MARKA_SITELERI.find(([desen]) => desen.test(basliklar));
    ozet += `<p class="meta">Bu ürünün resmi fiyatı otomatik bulunamadı. ${marka ? `<a href="${marka[2]}" target="_blank" rel="noopener">${marka[1]} Japonya sitesinde</a> model kodunu aratarak` : "Markanın Japonya sitesinden"} kontrol edin. Bulduğunuz resmi fiyatı <a href="/hesaplayici/">hesaplayıcıya</a> girerek vergi iadesi ve gümrükle birlikte karşılaştırabilirsiniz.</p>`;
  }
  if (jpAd) {
    const kodYazisi = (q.split(/[\s,/]+/).find((t) => sade(t) === modelKodu(q)) || q).toUpperCase();
    const ad = temizle(jpAd).slice(0, 80);
    ozet += `<div class="jp-goster"><span class="meta">${u.adDa} mağazada sorarken bunu gösterin:</span><div lang="ja">${kacis(ad)}</div>${sade(ad).includes(sade(kodYazisi)) ? "" : `<div><strong>${kacis(kodYazisi)}</strong></div>`}</div>`;
  }
  ozet += `</div>`;
  $("ozet").innerHTML = ozet;

  const liste = sonuclar.map((r) => ({ r, s: hesapla({ fiyat: r.fiyat, ulke: u, kur, trFiyat, iadeli: false }) }));
  if (sira === "ucuz") liste.sort((a, b) => a.r.fiyat - b.r.fiyat);
  if (sira === "puan") liste.sort((a, b) => (b.r.puan || 0) - (a.r.puan || 0));
  liste.sort((a, b) => (a.r.aksesuar + kodFarkli(a.r, q)) - (b.r.aksesuar + kodFarkli(b.r, q)));

  let sayac = 1;
  $("kademeler").innerHTML = KADEMELER.map((k) => {
    const ogeler = liste.filter((x) => (x.r.tur === "resmi" ? "yetkili" : x.r.tur) === k.tur);
    if (!ogeler.length) return "";
    sayac++;
    const ic = `<p class="meta">${k.aciklama}</p><ul class="sonuclar">${ogeler.map((x) => satir(x, ctx)).join("")}</ul>`;
    return k.tur === "ikinciel"
      ? `<details class="kademe"><summary><h2>${sayac}. ${k.baslik} (${ogeler.length})</h2></summary>${ic}</details>`
      : `<section class="kademe"><h2>${sayac}. ${k.baslik} (${ogeler.length})</h2>${ic}</section>`;
  }).join("");
}

$("arama").addEventListener("submit", async (e) => {
  e.preventDefault();
  const q = $("q").value.trim();
  const u = ULKELER.find((x) => x.kod === $("ulke").value);
  const urunTuru = $("tur").value;
  $("ozet").innerHTML = $("kademeler").innerHTML = "";
  sonVeri = null;

  const bizden = SAATLER.filter((s) => urunTuru === "saat" && s.ulke === u.kod && (sade(s.referans).includes(sade(q)) || sade(q).includes(sade(s.referans)) || s.ad.toLowerCase().includes(q.toLowerCase())));
  $("bizden").innerHTML = bizden.length
    ? `<div class="sonuc"><strong>Zamanist'te incelendi:</strong> ${bizden.map((s) => `<a href="${s.url}">${kacis(s.ad)}</a>`).join(", ")}. Mağaza adresleri bu sayfada.</div>`
    : "";
  if (!$("trFiyat").value && bizden.length === 1 && bizden[0].tr) $("trFiyat").value = bizden[0].tr;

  $("durum").textContent = "Aranıyor…";
  try {
    const [kur, cevap, resmiSite] = await Promise.all([
      kurGetir(u.para),
      fetch(`/api/ara?ulke=${u.kod}&tur=${urunTuru}&q=${encodeURIComponent(q)}`).then((r) => r.json()),
      fetch(`/api/resmi?ulke=${u.kod}&q=${encodeURIComponent(q)}`).then((r) => r.json()).catch(() => null),
    ]);
    if (cevap.hata) { $("durum").textContent = cevap.hata; return; }
    sonVeri = { u, kur, q, sonuclar: cevap.sonuclar, resmiSite, urunTuru };
    $("durum").textContent = cevap.sonuclar.length || resmiSite?.bulundu
      ? `${cevap.sonuclar.length} satıcı ilanı. 1 ${u.para} = ${kur.TRY.toLocaleString("tr-TR", { maximumFractionDigits: 4 })} TL (${kur.tarih} kuru).`
      : "Sonuç bulunamadı. Model kodunu veya İngilizce adını deneyin.";
    ciz();
  } catch (err) {
    $("durum").textContent = "Arama şu an yapılamadı. Biraz sonra tekrar deneyin.";
  }
});
["trFiyat", "sira"].forEach((id) => $(id).addEventListener("input", ciz));
["tur", "numara"].forEach((id) => $(id).addEventListener("input", () => { numaraGoster(); ciz(); }));
numaraGoster();
</script>
