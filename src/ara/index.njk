layout: base.njk
title: Yurt Dışında Ara
ozet: Ürünü yazın, seçtiğiniz ülkedeki satıcıları, fiyatları ve Türkiye'ye göre farkı görün.
permalink: /ara/
---
<h1>Yurt Dışında Ara</h1>
<p class="slogan">Ürünü yazın: önce markanın resmi fiyatı, sonra yetkili satıcılar, elektronik mağazaları ve pazar yerleri. Hepsi güncel kurla TL olarak.</p>

<dialog class="buyuk-foto" id="buyukFoto">
  <form method="dialog"><button>Kapat ✕</button></form>
  <img alt="Ürün fotoğrafı">
  <p><a target="_blank" rel="nofollow noopener"></a></p>
</dialog>
<form class="hesap" id="arama">
  <label>Ülke
    <select id="ulke">
      {%- for u in ulkeler %}
      <option value="{{ u.kod }}">{{ u.ad }}</option>
      {%- endfor %}
    </select>
  </label>
  <label id="numaraAlan" hidden>Numaranız (EU, isteğe bağlı)
    <select id="numara">
      <option value="">Seçin</option>
      {%- for t in turler %}{% for n in t.numaralar %}
      <option value="{{ n.eu }}">EU {{ n.eu }}</option>
      {%- endfor %}{% endfor %}
    </select>
  </label>
  <label>Ürün adı veya model kodu
    <input id="q" type="search" required minlength="2" placeholder="Örn. H70405140, GMW-BZ5000GD-9 veya Air Force 1 CW2288-111">
  </label>
  <label>Türkiye fiyatı (TL, isteğe bağlı)
    <input id="trFiyat" class="tutar" type="text" inputmode="decimal" autocomplete="off" placeholder="Karşılaştırma için">
    <span class="meta" id="trKaynak"></span>
  </label>
  <label>Sıralama
    <select id="sira">
      <option value="ilgi">En ilgili</option>
      <option value="ucuz">En ucuz</option>
      <option value="puan">En yüksek puan</option>
    </select>
  </label>
  <button type="submit">Ara</button>
</form>

<p class="meta" id="durum"></p>
<div id="numaraBilgi"></div>
<div id="bizden"></div>
<div id="ozet"></div>
<div id="kademeler"></div>
<p class="meta">Resmi fiyat sırasıyla Zamanist'in kontrol ettiği listeden, markanın sitesinden veya markanın resmi Rakuten mağazasından alınır. Diğer fiyatlar Rakuten'deki satıcılardan gelir. Online alışverişte vergi iadesi yoktur ve ürün Japonya'daki bir adrese (örneğin otel) gönderilmelidir. "Resmi garantili" bilgisi satıcının beyanıdır. Model kodunu mutlaka kontrol edin.</p>

<script src="/js/hesap.js"></script>
<script src="/js/japonca.js"></script>
<script>
const ULKELER = {{ ulkeler | dump | safe }};
const TURLER = {{ turler | dump | safe }};
const SAATLER = [
  {%- for p in collections.saatler %}
  { ad: {{ p.data.title | dump | safe }}, referans: {{ p.data.referans | dump | safe }}, url: "{{ p.url }}", ulke: "{{ p.data.ulke }}", tr: {{ p.data.tr_fiyat or "null" }} },
  {%- endfor %}
];
// Resmi fiyat otomatik bulunamazsa gösterilecek marka siteleri (ilan başlıklarından tanınır).
// [name pattern, brand, Japanese site, search link, product page link by model code].
// Product links follow each brand's own URL scheme; the brand redirects them to the product page.
const MARKA_SITELERI = [
  [/CASIO|カシオ|G-SHOCK|Gショック/i, "Casio", "https://www.casio.com/jp/watches/", null,
    (k) => /^G|^DW|^GA|^GM|^GW|^MTG/.test(k) && `https://www.casio.com/jp/watches/gshock/product.${k.replace(/(JF|JR|DR|ER|PR)$/, "")}/`],
  [/SEIKO|セイコー/i, "Seiko", "https://www.seikowatches.com/jp-ja", (q) => `https://www.seikowatches.com/jp-ja/search?q=${encodeURIComponent(q)}`],
  [/CITIZEN|シチズン/i, "Citizen", "https://citizen.jp/"],
  [/ORIENT|オリエント/i, "Orient", "https://www.orient-watch.jp/"],
  [/HAMILTON|ハミルトン/i, "Hamilton", "https://www.hamiltonwatch.com/ja-jp/"],
  [/TISSOT|ティソ/i, "Tissot", "https://www.tissotwatches.com/ja-jp/", null, (k) => /^T\d{12,13}$/.test(sade(k).toUpperCase()) && `https://www.tissotwatches.com/ja-jp/${sade(k).toUpperCase()}.html`],
  [/LONGINES|ロンジン/i, "Longines", "https://www.longines.com/ja-jp/"],
  [/NIKE|ナイキ/i, "Nike", "https://www.nike.com/jp/", (q) => `https://www.nike.com/jp/w?q=${encodeURIComponent(q)}`,
    (k) => /^([A-Z]{2}\d{4}|\d{6})-\d{3}$/.test(k) && `https://www.nike.com/jp/t/x/${k}`],
  [/ADIDAS|アディダス/i, "Adidas", "https://www.adidas.jp/", null, (k) => /^[A-Z]{1,2}\d{4,5}$/.test(k) && `https://www.adidas.jp/-/${k}.html`],
  [/NEW BALANCE|ニューバランス/i, "New Balance", "https://shop.newbalance.jp/"],
  [/ASICS|アシックス/i, "Asics", "https://www.asics.com/jp/ja-jp/"],
  [/ONITSUKA|オニツカ/i, "Onitsuka Tiger", "https://www.onitsukatiger.com/jp/ja-jp/"],
];
// Link to the product on the brand's Japanese site. With a model code: the product page itself
// (brand URL scheme, or Google's first result on that site). Without one: the brand's search.
// yok: the brand's site was already asked for this code and has no such page.
function markaLinki(marka, kod, q, yok) {
  const site = new URL(marka[2]).host;
  if (kod && yok && marka[3]) return marka[3](kod);
  if (kod) return (!yok && marka[4] && marka[4](kod)) || `https://www.google.com/search?btnI=1&q=${encodeURIComponent(`site:${site} ${kod}`)}`;
  return marka[3] ? marka[3](q) : `https://www.google.com/search?q=${encodeURIComponent(`site:${site} ${q}`)}`;
}

// Distinct models among the listings, most listed first: code, photo, lowest price.
function modelSecenekleri(sonuclar) {
  const m = {};
  for (const r of sonuclar.filter((r) => r.tur !== "ikinciel" && !r.aksesuar)) {
    const kod = ilanKodlari(r.ad)[0];
    if (!kod) continue;
    m[kod] = m[kod] || { kod, adet: 0, fiyat: Infinity, resim: r.resim };
    m[kod].adet++;
    m[kod].fiyat = Math.min(m[kod].fiyat, r.fiyat);
  }
  return Object.values(m).sort((a, b) => b.adet - a.adet).slice(0, 8);
}
document.addEventListener("click", (e) => {
  const b = e.target.closest(".model-sec");
  if (!b) return;
  $("q").value = b.dataset.kod;
  $("arama").requestSubmit();
  $("arama").scrollIntoView({ behavior: "smooth" });
});

// Model codes in a listing title ("DX5883-100", "GMW-BZ5000GD-9JF").
const ilanKodlari = (ad) => [...new Set(ad.toUpperCase().split(/[^A-Z0-9-]+/).filter((k) => /[A-Z]/.test(k) && /\d/.test(k) && k.replace(/-/g, "").length >= 6 && !/^\d+(CM|MM)$/.test(k)))];

// Model code most listings agree on ("DX5883-100"), for queries typed without one.
function ilanKodu(sonuclar) {
  const sayac = {};
  for (const r of sonuclar.filter((r) => r.tur !== "ikinciel" && !r.aksesuar)) {
    ilanKodlari(r.ad).forEach((k) => (sayac[k] = (sayac[k] || 0) + 1));
  }
  const [kod, adet] = Object.entries(sayac).sort((a, b) => b[1] - a[1])[0] || [];
  // Only when most listings agree; otherwise the query matches several colorways.
  const toplam = sonuclar.filter((r) => r.tur !== "ikinciel" && !r.aksesuar).length;
  return adet >= 2 && adet * 2 >= toplam ? kod : null;
}

const KADEMELER = [
  { tur: "yetkili", baslik: "Yetkili satıcılar", aciklama: "Resmi garantili sattığını belirten mağazalar. Bazı markalarda (ör. Seiko, Casio) resmi fiyatın altında satarlar; her ilanda resmi fiyata göre fark yazıyor." },
  { tur: "zincir", baslik: "Elektronik ve indirim mağazaları", aciklama: "Bu zincirlerin fiziksel şubelerinde pasaportla vergi iadesi de alınabilir. Saati mağazada sormak için aşağıdaki Japonca adı gösterin." },
  { tur: "pazar", baslik: "Pazar yeri satıcıları", aciklama: "Rakuten'deki diğer satıcılar. Fiyatlar resmi fiyattan yüksek veya düşük olabilir; satıcı puanına bakın." },
  { tur: "ikinciel", baslik: "İkinci el", aciklama: "Kullanılmış ürünler." },
];
const { kurGetir, hesapla, tl, para, euro, fark, GUMRUK_METNI, kararHtml, sayiOku } = Zamanist;
const { temizle, etiketler, santimler } = Japonca;

// "27 cm, 27.5 cm" -> "27 cm (EU 42.5), 27.5 cm (EU 43)"
function cmToEu(etiket, numaralar) {
  return etiket.split(", ").map((p) => {
    const n = numaralar.find((x) => parseFloat(x.cm) === parseFloat(p));
    return n ? `${p} (EU ${n.eu})` : p;
  }).join(", ");
}

// Product type is guessed from the listings: shoe words vs watch words in the titles.
function turTahmin(sonuclar, resmiSite) {
  if (resmiSite?.marka === "Nike") return "ayakkabi";
  const say = (desen) => sonuclar.filter((r) => desen.test(r.ad)).length;
  return say(/スニーカー|シューズ|靴|sneaker|shoe/i) > say(/腕時計|ウォッチ|watch/i) ? "ayakkabi" : "saat";
}

function numaraGoster() {
  const t = TURLER.find((x) => x.kod === (sonVeri?.urunTuru || "saat"));
  $("numaraAlan").hidden = !t.numaralar;
  const n = t.numaralar && t.numaralar.find((x) => x.eu === $("numara").value);
  $("numaraBilgi").innerHTML = n
    ? `<div class="sonuc"><strong>Numaranız:</strong> EU ${n.eu} = Japonya'da <strong>${n.cm} cm</strong> = US ${n.us} = UK ${n.uk}<p class="meta">${kacis(t.numaraNotu)}</p></div>`
    : "";
}
const $ = (id) => document.getElementById(id);
const kacis = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
const sade = (s) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
let sonVeri = null;

// Model koduyla arandığında, ilan linkindeki ürün kodu farklı bir modeli gösteriyorsa uyar.
// Sorgudaki model kodu: harf ve rakam içeren en uzun kelime ("TISSOT T129... CLASSIC" -> "t129...").
const modelKodu = (q) => q.split(/[\s,/]+/).map(sade).filter((k) => /[a-z]/.test(k) && /[0-9]/.test(k) && k.length >= 5).sort((a, b) => b.length - a.length)[0] || sade(q);

function kodFarkli(r, q) {
  const kod = modelKodu(q);
  if (!/[a-z]/.test(kod) || !/[0-9]/.test(kod)) return false;
  const linkKodu = sade(new URL(r.link).pathname.split("/").filter(Boolean).pop() || "");
  return /[a-z]/.test(linkKodu) && /[0-9]/.test(linkKodu) && !linkKodu.includes(kod) && !kod.includes(linkKodu);
}

function resmiFarki(fiyat, resmi) {
  if (!resmi) return "";
  const y = Math.round((fiyat / resmi.fiyat - 1) * 100);
  if (Math.abs(y) < 3) return '<span class="etiket">Resmi fiyatla aynı</span>';
  return y > 0 ? `<span class="etiket uyari">Resmi fiyatın %${y} üstünde</span>` : `<span class="etiket iyi">Resmi fiyatın %${-y} altında</span>`;
}

// Rakuten thumbnails carry their size in "?_ex=128x128"; ask for a larger copy for the zoom view.
const buyukResim = (url) => url.replace(/\?_ex=\d+x\d+/, "?_ex=600x600");
const fotoDugmesi = (r) =>
  `<button type="button" class="foto" data-buyuk="${kacis(buyukResim(r.resim))}" data-link="${kacis(r.link)}" data-magaza="${kacis(r.magaza)}" aria-label="Fotoğrafı büyüt"><img src="${kacis(r.resim)}" alt="" loading="lazy"></button>`;

document.addEventListener("click", (e) => {
  const b = e.target.closest(".foto");
  if (!b) return;
  const d = $("buyukFoto");
  d.querySelector("img").src = b.dataset.buyuk;
  d.querySelector("a").href = b.dataset.link;
  d.querySelector("a").textContent = `${b.dataset.magaza} ilanını aç`;
  d.showModal();
});

function satir({ r, s }, ctx) {
  const tr = etiketler(r.ad, ctx.urunTuru).map((e) => ctx.numaralar && / cm/.test(e) ? cmToEu(e, ctx.numaralar) : e);
  const numaraVar = ctx.secili && santimler(r.ad).includes(String(parseFloat(ctx.secili.cm)));
  return `
    <li>
      ${r.resim ? fotoDugmesi(r) : "<span></span>"}
      <div>
        <div class="fiyat">${para(r.fiyat, ctx.u.para)} = ${tl(s.netTl)} ${resmiFarki(r.fiyat, ctx.resmi)}</div>
        ${tr.length ? `<div class="tr-etiketler">${tr.map(kacis).join(" · ")}</div>` : ""}
        <a class="jp-ad" href="${kacis(r.link)}" target="_blank" rel="nofollow noopener" lang="ja">${kacis(temizle(r.ad).slice(0, 110))}</a>
        <div class="meta">${kacis(r.magaza)}${r.puan ? ` · ★ ${r.puan.toFixed(2)} (${r.yorumSayisi} yorum)` : " · Puan yok"}${r.kargoDahil ? " · Kargo dahil" : ""}</div>
        <div>${r.aksesuar ? '<span class="etiket uyari">Aksesuar olabilir</span> ' : ""}${kodFarkli(r, ctx.q) ? '<span class="etiket uyari">Model kodu farklı olabilir</span>' : ""}${numaraVar ? '<span class="etiket iyi">Numaranız ilanda geçiyor</span>' : ""}</div>
        ${s.karar ? `<div class="meta">Türkiye'ye göre: ${fark(s.gumrukTl > 0 ? s.farkVergili : s.farkVergisiz, ctx.trFiyat)}${s.gumrukTl > 0 ? " (gümrük vergisi dahil)" : ""}</div>` : ""}
      </div>
    </li>`;
}

// Small calculator in the summary: the price the user read on the brand's site, in TL.
function elleHesapla() {
  const kutu = $("elleSonuc");
  if (!kutu || !sonVeri) return;
  const { u, kur } = sonVeri;
  const fiyat = sayiOku($("elleFiyat").value);
  const trFiyat = sayiOku($("trFiyat").value);
  if (!(fiyat > 0)) { kutu.innerHTML = ""; return; }
  const magazada = hesapla({ fiyat, ulke: u, kur, trFiyat, iadeli: true });
  const online = hesapla({ fiyat, ulke: u, kur, trFiyat, iadeli: false });
  kutu.innerHTML = `<dl>
    <dt>Fiyat</dt><dd><strong>${para(fiyat, u.para)} = ${tl(online.netTl)}</strong></dd>
    ${magazada.iadeVar ? `<dt>Mağazadan pasaportla</dt><dd>${tl(magazada.netTl)} (vergi iadesi sonrası)</dd>` : ""}
    <dt>Gümrük</dt><dd>${GUMRUK_METNI[magazada.gumruk](magazada)}</dd>
    ${magazada.karar ? `<dt>Türkiye'ye göre</dt><dd>${fark(magazada.gumrukTl > 0 ? magazada.farkVergili : magazada.farkVergisiz, trFiyat)}${magazada.gumrukTl > 0 ? " (gümrük vergisi dahil)" : ""}</dd>` : `<dt></dt><dd class="meta">Türkiye fiyatını yukarıya yazarsanız karşılaştırma da çıkar.</dd>`}
  </dl>${kararHtml(magazada.karar)}`;
}
document.addEventListener("input", (e) => {
  if (e.target.id !== "elleFiyat" || !sonVeri) return;
  sonVeri.elleFiyat = e.target.value;
  elleHesapla();
});

function ciz() {
  if (!sonVeri) return;
  const { u, kur, sonuclar, resmiSite, urunTuru } = sonVeri;
  // A code found in the listings stands in for a query typed without one.
  const q = sonVeri.bulunanKod || sonVeri.q;
  const trFiyat = sayiOku($("trFiyat").value);
  const sira = $("sira").value;

  // Resmi fiyat: önce markanın sitesi, yoksa markanın resmi Rakuten mağazası.
  // "公式" bazı bayilerin mağaza adında da geçer; resmi sayılması için mağaza adında markanın adı da olmalı.
  const markaMagazasi = (r) => MARKA_SITELERI.some(([desen]) => desen.test(r.ad) && desen.test(r.magaza));
  const resmiRakuten = sonuclar.filter((r) => r.tur === "resmi" && markaMagazasi(r) && !r.aksesuar && !kodFarkli(r, q)).sort((a, b) => a.fiyat - b.fiyat)[0];
  // Panelden girilen liste önce gelir: doğruluğunu biz kontrol ettik.
  const kod = modelKodu(q);
  const listede = (sonVeri.resmiListe || []).find((x) => x.ulke === u.kod && kod.length >= 6 && (sade(x.kod).startsWith(kod) || kod.startsWith(sade(x.kod))));
  const resmi = listede
    ? { fiyat: listede.fiyat, kaynak: `${listede.marka} resmi fiyatı (Zamanist listesi, ${new Date(listede.tarih).toLocaleDateString("tr-TR")})`, link: listede.kaynak, jpAd: listede.ad || listede.kod }
    : resmiSite?.bulundu
    ? { fiyat: resmiSite.fiyat, indirimli: resmiSite.indirimli, kaynak: `${resmiSite.marka} ${u.ad} resmi sitesi`, link: resmiSite.link, jpAd: resmiSite.urunAdi }
    : resmiRakuten ? { fiyat: resmiRakuten.fiyat, kaynak: `${resmiRakuten.magaza} (markanın resmi Rakuten mağazası)`, link: resmiRakuten.link, jpAd: temizle(resmiRakuten.ad) }
    : null;
  const turBilgi = TURLER.find((x) => x.kod === urunTuru);
  const secili = turBilgi.numaralar && turBilgi.numaralar.find((x) => x.eu === $("numara").value);
  const ctx = { u, q, resmi, trFiyat, urunTuru, numaralar: turBilgi.numaralar, secili };

  // Mağazada gösterilecek Japonca ad
  const jpAd = resmi?.jpAd || (sonuclar.find((r) => r.tur !== "ikinciel" && !r.aksesuar && !kodFarkli(r, q)) || {}).ad;
  let ozet = `<div class="sonuc"><h2>1. Markanın resmi fiyatı</h2>`;
  if (sonVeri.bulunanKod) ozet += `<p class="meta">Model kodu ilanlardan bulundu: <strong>${kacis(sonVeri.bulunanKod)}</strong>. Aradığınız ürün değilse model kodunu yazarak arayın.</p>`;
  if (resmi) {
    const magazada = hesapla({ fiyat: resmi.fiyat, ulke: u, kur, trFiyat, iadeli: true });
    const indirim = resmi.indirimli && hesapla({ fiyat: resmi.indirimli, ulke: u, kur, trFiyat, iadeli: false });
    // Verdict uses the cheaper of: list price in store with tax refund, or the brand's online sale price.
    const s = indirim && indirim.netTl < magazada.netTl ? indirim : magazada;
    ozet += `<dl>
      <dt>Resmi fiyat</dt><dd><strong>${para(resmi.fiyat, u.para)} = ${tl(resmi.fiyat * kur.TRY)}</strong> · <a href="${kacis(resmi.link)}" target="_blank" rel="nofollow noopener">${kacis(resmi.kaynak)}</a></dd>
      <dt>Mağazadan pasaportla</dt><dd>${tl(magazada.netTl)} (vergi iadesi sonrası, yaklaşık ${euro(magazada.netEur)})</dd>
      ${indirim ? `<dt>Markanın sitesinde indirimde</dt><dd><strong>${para(resmi.indirimli, u.para)} = ${tl(indirim.netTl)}</strong> · Online fiyat; vergi iadesi yok, ${u.adDa}ki bir adrese (otel) teslim. Mağazada bu indirim olmayabilir.</dd>` : ""}
      <dt>Gümrük</dt><dd>${GUMRUK_METNI[s.gumruk](s)}</dd>
      ${s.karar ? `<dt>Türkiye'ye göre</dt><dd>${s.gumrukTl > 0 ? `Gümrük vergisi hariç ${fark(s.farkVergisiz, trFiyat)}<br>Gümrük vergisi dahil ${fark(s.farkVergili, trFiyat)}` : fark(s.farkVergisiz, trFiyat)}</dd>` : ""}
    </dl>${kararHtml(s.karar)}`;
  } else {
    const basliklar = sonuclar.map((r) => r.ad).join(" ");
    const marka = MARKA_SITELERI.find(([desen]) => desen.test(basliklar));
    const yazilanKod = (sonVeri.q.split(/[\s,/]+/).find((t) => /[a-z]/i.test(t) && /\d/.test(t) && sade(t).length >= 5) || "").toUpperCase();
    const kod = yazilanKod || sonVeri.bulunanKod;
    if (kod || !modelSecenekleri(sonuclar).length) {
      ozet += `<p>Bu ürünün resmi fiyatı otomatik okunamadı. ${marka
        ? `<a class="dugme-kucuk" href="${kacis(markaLinki(marka, kod, q, resmiSite?.neden === "bulunamadi"))}" target="_blank" rel="noopener">${kod ? `${kacis(kod)} ürün sayfasını` : "Ürünü"} ${marka[1]} ${u.ad} sitesinde aç ↗</a>`
        : "Ürünü markanın " + u.ad + " sitesinde bulun,"} orada gördüğünüz fiyatı aşağıya yazın.</p>`;
    } else {
      // Name without a code matches several models: let the user pick one, then search by its code.
      ozet += `<p>Bu adla birden fazla model var. Hangisini arıyorsunuz? Seçince o modelin resmi fiyatı ve ürün sayfası gelir.</p>
        <ul class="modeller">${modelSecenekleri(sonuclar).map((m) => `<li><button type="button" class="model-sec" data-kod="${kacis(m.kod)}">${m.resim ? `<img src="${kacis(m.resim)}" alt="" loading="lazy">` : ""}<strong>${kacis(m.kod)}</strong><span class="meta">${m.adet} ilan · en düşük ${para(m.fiyat, u.para)}</span></button></li>`).join("")}</ul>`;
    }
  }
  ozet += `<div class="mini-hesap">
    <label>${resmi ? "Sitede farklı bir fiyat mı gördünüz?" : "Resmi sitede gördüğünüz fiyat"} (${u.para})
      <input id="elleFiyat" class="tutar" type="text" inputmode="decimal" autocomplete="off" placeholder="Örn. 16.500" value="${kacis(sonVeri.elleFiyat || "")}">
    </label>
    <div id="elleSonuc"></div>
  </div>`;
  // Photo of the product we matched, so the user can check it is the right model before asking in a store.
  const ornek = resmiRakuten || sonuclar.find((r) => r.resim && r.tur !== "ikinciel" && !r.aksesuar && !kodFarkli(r, q));
  if (ornek && ornek.resim) {
    ozet += `<div class="bulunan">${fotoDugmesi(ornek)}<p class="meta">Aradığınız ürün bu mu? Fotoğraf ${kacis(ornek.magaza)} ilanından. Büyütmek için tıklayın; ${urunTuru === "saat" ? "renk ve kadranı" : "renk ve modeli"} kontrol edin.</p></div>`;
  }
  if (jpAd) {
    const kodYazisi = (q.split(/[\s,/]+/).find((t) => sade(t) === modelKodu(q)) || q).toUpperCase();
    const ad = temizle(jpAd).slice(0, 80);
    ozet += `<div class="jp-goster"><span class="meta">${u.adDa} mağazada sorarken bunu gösterin:</span><div lang="ja">${kacis(ad)}</div>${sade(ad).includes(sade(kodYazisi)) ? "" : `<div><strong>${kacis(kodYazisi)}</strong></div>`}</div>`;
  }
  ozet += `</div>`;
  $("ozet").innerHTML = ozet;
  elleHesapla();

  const liste = sonuclar.map((r) => ({ r, s: hesapla({ fiyat: r.fiyat, ulke: u, kur, trFiyat, iadeli: false }) }));
  if (sira === "ucuz") liste.sort((a, b) => a.r.fiyat - b.r.fiyat);
  if (sira === "puan") liste.sort((a, b) => (b.r.puan || 0) - (a.r.puan || 0));
  liste.sort((a, b) => (a.r.aksesuar + kodFarkli(a.r, q)) - (b.r.aksesuar + kodFarkli(b.r, q)));

  let sayac = 1;
  $("kademeler").innerHTML = KADEMELER.map((k) => {
    // Markanın kendi mağazası yetkili sayılır; adında sadece "公式" geçen bayiler pazar yerine gider.
    const kademe = (r) => r.tur !== "resmi" ? r.tur : markaMagazasi(r) ? "yetkili" : "pazar";
    const ogeler = liste.filter((x) => kademe(x.r) === k.tur);
    if (!ogeler.length) return "";
    sayac++;
    const ic = `<p class="meta">${k.aciklama}</p><ul class="sonuclar">${ogeler.map((x) => satir(x, ctx)).join("")}</ul>`;
    return k.tur === "ikinciel"
      ? `<details class="kademe"><summary><h2>${sayac}. ${k.baslik} (${ogeler.length})</h2></summary>${ic}</details>`
      : `<section class="kademe"><h2>${sayac}. ${k.baslik} (${ogeler.length})</h2>${ic}</section>`;
  }).join("");
}

$("arama").addEventListener("submit", async (e) => {
  e.preventDefault();
  const q = $("q").value.trim();
  const u = ULKELER.find((x) => x.kod === $("ulke").value);
  $("ozet").innerHTML = $("kademeler").innerHTML = "";
  sonVeri = null;

  const bizden = SAATLER.filter((s) => s.ulke === u.kod && (sade(s.referans).includes(sade(q)) || sade(q).includes(sade(s.referans)) || s.ad.toLowerCase().includes(q.toLowerCase())));
  $("bizden").innerHTML = bizden.length
    ? `<div class="sonuc"><strong>Zamanist'te incelendi:</strong> ${bizden.map((s) => `<a href="${s.url}">${kacis(s.ad)}</a>`).join(", ")}. Mağaza adresleri bu sayfada.</div>`
    : "";
  if (!$("trFiyat").value && bizden.length === 1 && bizden[0].tr) { $("trFiyat").value = Number(bizden[0].tr).toLocaleString("tr-TR"); $("trFiyat").dataset.otomatik = "1"; }

  // A price filled automatically for the previous product does not belong to this one.
  if ($("trFiyat").dataset.otomatik) { $("trFiyat").value = ""; delete $("trFiyat").dataset.otomatik; $("trKaynak").textContent = ""; }
  $("durum").textContent = "Aranıyor…";
  try {
    let [kur, cevap, resmiSite, resmiListe] = await Promise.all([
      kurGetir(u.para),
      fetch(`/api/ara?ulke=${u.kod}&q=${encodeURIComponent(q)}`).then((r) => r.json()),
      fetch(`/api/resmi?ulke=${u.kod}&q=${encodeURIComponent(q)}`).then((r) => r.json()).catch(() => null),
      fetch("/resmi-fiyatlar.json").then((r) => r.json()).catch(() => []),
    ]);
    if (cevap.hata) { $("durum").textContent = cevap.hata; return; }
    // No code in the query: take it from the listings and ask the brand's site again.
    const kodsuz = !q.split(/[\s,/]+/).some((t) => /[a-z]/i.test(t) && /\d/.test(t) && sade(t).length >= 5);
    const bulunanKod = kodsuz ? ilanKodu(cevap.sonuclar) : null;
    if (bulunanKod && !resmiSite?.bulundu) {
      resmiSite = await fetch(`/api/resmi?ulke=${u.kod}&q=${encodeURIComponent(bulunanKod)}`).then((r) => r.json()).catch(() => resmiSite);
    }
    sonVeri = { u, kur, q, bulunanKod, sonuclar: cevap.sonuclar, resmiSite, resmiListe, urunTuru: turTahmin(cevap.sonuclar, resmiSite) };
    // Fill the Turkish price from the brand's Turkish site when the user left it empty.
    if (!$("trFiyat").value && resmiSite?.tr) {
      $("trFiyat").value = Math.round(resmiSite.tr.fiyat).toLocaleString("tr-TR");
      $("trFiyat").dataset.otomatik = "1";
      $("trKaynak").innerHTML = `Türkiye fiyatı otomatik eklendi: <a href="${kacis(resmiSite.tr.link)}" target="_blank" rel="nofollow noopener">${kacis(resmiSite.tr.kaynak)}</a>`;
    }
    numaraGoster();
    $("durum").textContent = cevap.sonuclar.length || resmiSite?.bulundu
      ? `${cevap.sonuclar.length} satıcı ilanı. 1 ${u.para} = ${kur.TRY.toLocaleString("tr-TR", { maximumFractionDigits: 4 })} TL (${kur.tarih} kuru).`
      : "Sonuç bulunamadı. Model kodunu veya İngilizce adını deneyin.";
    ciz();
  } catch (err) {
    $("durum").textContent = "Arama şu an yapılamadı. Biraz sonra tekrar deneyin.";
  }
});
["trFiyat", "sira"].forEach((id) => $(id).addEventListener("input", ciz));
$("numara").addEventListener("input", () => { numaraGoster(); ciz(); });
$("trFiyat").addEventListener("input", () => { delete $("trFiyat").dataset.otomatik; $("trKaynak").textContent = ""; });
numaraGoster();
</script>
