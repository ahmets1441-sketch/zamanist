---
layout: base.njk
title: Ana sayfa
---
{#- Basiclink first: the newest outfit as a runway, then earlier posts. -#}
{%- set vitrin = collections.basiclink | vitrinPostu %}
{%- if vitrin %}
<link rel="stylesheet" href="/css/podyum.css">
<section class="bolum basiclink-vitrin" id="basiclink">
  <p class="vitrin-ust"><a href="/basiclink/">basiclink.</a> · <a href="https://www.instagram.com/{{ site.instagram }}/" rel="noopener" target="_blank">@{{ site.instagram }}</a></p>
  <h1 class="vitrin-baslik"><a href="{{ vitrin.url }}">{{ vitrin.data.title }}</a></h1>
  {%- set looks = { looklar: vitrin.data.looklar, urunler: vitrin.data.urunler, tags: vitrin.data.tags, slaytlar: vitrin.data.slaytlar, page: vitrin.page } | podyumLooklari %}
  {%- set baslik = vitrin.data.title %}{% set sayfaLinki = vitrin.url %}
  {% include "podyum.njk" %}
</section>
<script src="/js/podyum.js" defer></script>
{%- endif %}

{#- Every outfit (Instagram posts and editorial outfits) in one grid, the showcase left out. -#}
{%- set kombinler = [] %}
{%- for p in collections.kombinlerim %}{% if p.url != vitrin.url and kombinler.length < 8 %}{% set kombinler = (kombinler.push(p), kombinler) %}{% endif %}{% endfor %}
{%- if kombinler.length %}
<section class="bolum goster" id="kombinler">
  <div class="bolum-baslik"><h2><a href="/basiclink/">Tüm kombinler</a></h2><a href="/basiclink/">Tümü →</a></div>
  <ul class="insta-izgara">
  {%- for p in kombinler %}
    <li><a href="{{ p.url }}"><img src="{{ p.data.kapak | kucukGorsel }}" alt="" loading="lazy"><span>{{ p.data.title }}</span></a></li>
  {%- endfor %}
  </ul>
</section>
{%- endif %}

<section class="bolum ana-indirim goster" id="anaIndirim" hidden>
  <div class="bolum-baslik"><h2><a href="/indirimler/">İndirim Takvimi</a></h2><a href="/indirimler/">Tümü →</a></div>
  <p class="bolum-aciklama">Türk markalarının indirimleri. Markaların sitesi her sabah kontrol edilir.</p>
  <div class="ana-indirim-ic">
    <div id="anaDevam"></div>
    <div id="anaYakin"></div>
  </div>
</section>
{% include "indirim-veri.njk" %}
<script>
// Fills the box from the same data and rules as /indirimler/, so both always agree.
(() => {
  const { liste, grupla, tarih, kisa, geriSayim, bitisYazisi } = Indirim;
  const kacis = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const g = grupla(liste);
  // Running sales are named by brand with their rate; upcoming ones by event name, since the rate is not known yet.
  const satir = (ad, oran, yan) => `<li><a href="/indirimler/"><strong>${kacis(ad)}</strong>${oran ? ` <span class="ana-oran">${kacis(oran)}</span>` : ""}</a><span class="meta">${yan}</span></li>`;
  const blok = (baslik, xs) => xs.length ? `<h3>${baslik}</h3><ul class="ana-indirim-liste">${xs.join("")}</ul>` : "";
  document.getElementById("anaDevam").innerHTML = blok("Şu an indirimde", g.devam.slice(0, 5).map((x) =>
    satir(x.grup || x.baslik, x.oran, x.bitis ? bitisYazisi(x) : `kontrol: ${kisa(tarih(x.kontrol || x.baslangic))}`)));
  document.getElementById("anaYakin").innerHTML = blok("Yaklaşan", g.yakinda.slice(0, 4).map((x) =>
    satir(x.baslik, "", `${geriSayim(x)} · ${kisa(tarih(x.baslangic))}${x.durum === "tahmini" ? " (tahmini)" : ""}`)));
  if (g.devam.length || g.yakinda.length) document.getElementById("anaIndirim").hidden = false;
})();
</script>

<section class="bolum goster" id="anaCikis" hidden>
  <div class="bolum-baslik"><h2><a href="/sinirli-seri/">Sınırlı Seri ve İş Birlikleri</a></h2><a href="/sinirli-seri/">Tümü →</a></div>
  <p class="bolum-aciklama">Saat, sneaker, giyim ve otomobilde yaklaşan sınırlı üretimler ve çıkış tarihleri.</p>
  <div class="yatay-kaydir" id="anaCikisListe"></div>
</section>
<script>
// Next releases with photos, from the same data as /sinirli-seri/.
(() => {
  const L = {{ sinirliSeri.cikislar | dump | safe }};
  const bugun = new Date(new Date().toDateString());
  const bas = (x) => { const [y, a, g] = x.tarih.split("-").map(Number); return new Date(y, a - 1, g || 1); };
  const AY = ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"];
  const KAT = { saat: "Saat", sneaker: "Sneaker", giyim: "Giyim", araba: "Otomobil" };
  const k = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const xs = L.filter((x) => x.gorsel && bas(x) >= bugun).sort((a, b) => bas(a) - bas(b)).slice(0, 8);
  if (!xs.length) return;
  document.getElementById("anaCikisListe").innerHTML = xs.map((x) => {
    const d = bas(x);
    return `<a class="mini-drop" href="/sinirli-seri/?kat=${x.kategori}"><span class="mini-drop-gorsel"><img src="${k(x.gorsel)}" alt="" loading="lazy"><span class="drop-rozet">${x.hassasiyet === "ay" ? AY[d.getMonth()] + " " + d.getFullYear() : d.getDate() + " " + AY[d.getMonth()]}</span></span><span class="mini-drop-kat">${KAT[x.kategori]} · ${k(x.marka)}</span><span class="mini-drop-ad">${k(x.baslik)}</span></a>`;
  }).join("");
  document.getElementById("anaCikis").hidden = false;
})();
</script>

<section class="ikinci-plan goster" id="ikinci-plan" aria-label="Diğer bölümler">
  <nav class="hizli-linkler" aria-label="Bölümlere git">
    <a href="#yurtdisi">Yurt dışı fiyat</a><a href="/saat/">Saat</a><a href="/otomobil/">Otomobil</a><a href="/rehberler/">Rehberler</a><a href="/hesaplayici/">Hesaplayıcı</a>
  </nav>
  <div class="yurtdisi-bant" id="yurtdisi">
  <div class="tanitim-metin">
    <p class="tanitim-ust">Yurt dışı fiyat karşılaştırma</p>
    <h2>Yurt dışında kaça, Türkiye'de kaça?</h2>
    <ol class="adimlar">
      <li>Saat, sneaker ya da kıyafet: ürün adını veya model kodunu yazın.</li>
      <li>Markanın resmi fiyatını, yetkili satıcıları ve pazar yerlerini görün. Hepsi güncel kurla TL.</li>
      <li>Türkiye fiyatını girin, aradaki farkı görün.</li>
    </ol>
    <form class="tanitim-form" action="/ara/" method="get">
      <label class="gizli" for="anaAra">Ürün adı veya model kodu</label>
      <input id="anaAra" name="q" type="search" required minlength="2" placeholder="Örn. Seiko SPB143 veya Air Force 1">
      <button type="submit">Ara</button>
    </form>
    <p class="meta">Şimdilik Japonya ve ABD (ABD'de satıcı ilanları yakında; resmi fiyat ve hesap çalışıyor). Elinizde bir fiyat varsa <a href="/hesaplayici/">Hesaplayıcı</a> TL'ye çevirir ve vergi iadesini düşer.</p>
  </div>
</div>
{% for bolum in bolumler %}
{% set yazilar = collections[bolum.slug] | head(3) %}
{% if yazilar.length and bolum.slug != "kombinlerim" %}
<div class="bolum" id="{{ bolum.slug }}">
  <div class="bolum-baslik"><h2><a href="/{{ bolum.slug }}/">{{ bolum.ad }}</a></h2><a href="/{{ bolum.slug }}/">Tümü →</a></div>
  <p class="bolum-aciklama">{{ bolum.aciklama }}</p>
  {% include "liste.njk" %}
</div>
{% endif %}
{% endfor %}
</section>
