<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.data.gizli and p.url != "/404.html" and not p.url.startsWith("/admin") and p.url != "/uyelik/" and p.url != "/arama/" and not p.url.endsWith(".xml") and not p.url.endsWith(".json") and not p.url.endsWith(".webmanifest") %}
  <url><loc>https://zamanist.com{{ p.url }}</loc><lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
