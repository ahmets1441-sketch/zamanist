<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Zamanist</title>
  <meta name="description" content="{{ ozet or description or 'Saat, stil ve beyefendi kültürü: kombinler, sporcuların stili, rehberler ve biyografiler.' }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="logo" href="/">Zamanist</a>
    <nav>
      {%- for b in bolumler %}
      <a href="/{{ b.slug }}/">{{ b.ad }}</a>
      {%- endfor %}
      <a href="/ara/">Ara</a>
      <a href="/saatler/">Saat Fiyatları</a>
      <a href="/hesaplayici/">Hesaplayıcı</a>
    </nav>
  </header>
  <main>{{ content | safe }}</main>
  <footer class="site-footer">© Zamanist · Saat, stil ve beyefendi kültürü</footer>
</body>
</html>
