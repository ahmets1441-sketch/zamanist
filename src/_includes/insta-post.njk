---
layout: base.njk
---
{#- One Instagram post of @basiclinkk. Outfit posts with looks render as a runway (podyum.njk); other posts show their
    slides, then every product with code, price and a link to the shop. -#}
{%- set looks = { looklar: looklar, urunler: urunler, tags: tags, slaytlar: slaytlar, page: page } | podyumLooklari %}
<p class="kirinti"><a href="/">Ana sayfa</a> › <a href="/basiclink/">Basiclink</a> › {{ title }}</p>
{%- if looks.length and not looks[0].slayt %}
<link rel="stylesheet" href="/css/podyum.css">
<div class="podyum-sayfa-ust">
  <h1>{{ title }}</h1>
  <p class="meta">{{ date | tarih }} · <a href="https://www.instagram.com/{{ site.instagram }}/" rel="noopener" target="_blank">@{{ site.instagram }}</a></p>
  <p>{{ ozet }}</p>
</div>
{%- set baslik = title %}{% set sayfaLinki = "" %}
{% include "podyum.njk" %}
<div class="podyum-sayfa-alt">
  {{ content | safe }}
  {% include "insta-not.njk" %}
</div>
<script src="/js/podyum.js" defer></script>
{%- else %}
<div class="insta-post">
  <div class="insta-slaytlar" aria-label="Post görselleri">
    {%- for i in range(1, slaytlar + 1) %}
    <img src="/img/insta/{{ page.fileSlug }}/{{ i }}.webp" width="1080" height="1350" alt="{{ title }}, {{ i }}. görsel" {% if i > 1 %}loading="lazy"{% endif %}>
    {%- endfor %}
  </div>
  <div class="insta-bilgi">
    <h1>{{ title }}</h1>
    <p class="meta">{{ date | tarih }} · <a href="https://www.instagram.com/{{ site.instagram }}/" rel="noopener" target="_blank">@{{ site.instagram }}</a></p>
    <p>{{ ozet }}</p>
    {{ content | safe }}
    <ul class="insta-urunler">
    {%- for u in urunler %}
      <li>
        <img src="{{ u.gorsel }}" alt="{{ u.marka }} {{ u.ad }}" loading="lazy">
        <div>
          <span class="iu-marka"{% if not r/[çğıöşüİ]/i.test(u.marka) %} lang="en"{% endif %}>{{ u.marka }}</span>
          <span class="iu-ad">{{ u.ad }}</span>
          {% if u.kod %}<span class="iu-kod">Model kodu: {{ u.kod }}</span>{% endif %}{% if u.satici and u.satici != u.marka %}<span class="iu-kod">Satıcı: {{ u.satici }}</span>{% endif %}
          <span class="iu-fiyat">{{ u.fiyat | sayi }} TL{% if u.eskiFiyat %} <s>{{ u.eskiFiyat | sayi }} TL</s>{% endif %}{% if u.fiyatNot %} <small>{{ u.fiyatNot }}</small>{% endif %}</span>
        </div>
        <a class="dugme-kucuk" href="{{ u.link }}" rel="nofollow noopener" target="_blank">Ürüne git</a>
      </li>
    {%- endfor %}
    </ul>
    {% include "insta-not.njk" %}
  </div>
</div>
{%- endif %}
